## Returns the glyph painted in `col`, optionally with a 1px outline (image is 18x18 then).
static func image(id: String, col: Color, outline: Color = Color(0, 0, 0, 0), thick: bool = false) -> Image:
	var rows: Array = GLYPHS[id]
	var pad := 1 if outline.a > 0.0 else 0
	var w := 16 + pad * 2 + (1 if thick else 0)
	var img := Image.create(w, 16 + pad * 2, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	for y in 16:
		var r: String = rows[y]
		for x in 16:
			if r[x] == "#":
				img.set_pixel(x + pad, y + pad, col)
				if thick:
					img.set_pixel(x + pad + 1, y + pad, col)
	if pad > 0:
		var src := img.duplicate() as Image
		for y in img.get_height():
			for x in img.get_width():
				if src.get_pixel(x, y).a > 0.5:
					continue
				for d in [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]:
					var q: Vector2i = Vector2i(x, y) + d
					if q.x >= 0 and q.y >= 0 and q.x < img.get_width() and q.y < img.get_height() and src.get_pixelv(q).a > 0.5:
						img.set_pixel(x, y, outline)
						break
	return img
